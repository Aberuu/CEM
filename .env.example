# Isi nilai berikut di Project Settings -> Environment Variables pada Vercel (atau di file .env lokal).
# Jangan pernah menyimpan nilai asli ke GitHub.
GCAL_CALENDAR_ID=
GCAL_API_KEY=
GCAL_OAUTH_CLIENT_ID=
# PIN untuk membuka panel Admin (diubah otomatis ke hash SHA-256 saat build Vercel).
ADMIN_PIN=
